# Copy to .env and fill in (PowerShell: Copy-Item .env.example .env)
# docker compose reads .env automatically. Don't commit the real .env.

# image / registry
DOCKERHUB_USER=your-dockerhub-username
APP_VERSION=1.0.0

# app settings passed into the web container
APP_TITLE=StudyPulse
APP_ENV=production
LOG_LEVEL=info
REDIS_HOST=redis
REDIS_PORT=6379

# host port mapped to the container's port 8000
#   laptop:                8000  (http://localhost:8000, 8080 is taken by Task 4.2)
#   EC2 HTTP only:         80    (http://<public-ip>)
#   EC2 with https:        8000  (caddy uses 80/443, 8000 stays closed in the security group)
HOST_PORT=8000

# only needed for the https profile. sslip.io points the name at your IP,
# e.g. 13-54-120-7.sslip.io for 13.54.120.7
DOMAIN=
